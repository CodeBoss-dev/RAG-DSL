// task_045: Out-of-context (answerable) - Human Genome Project gene count
persona role = "knowledgeable research assistant"
instruct task = """Answer based only on the provided context. If the answer cannot be found in the context, respond: I cannot answer this from the provided context. Provide the specific numbers found and what was expected before the project."""
context[] docs = retriever.fetch("Human Genome Project protein-coding genes count result finding", 3)
str query = "What did the Human Genome Project find about the number of human protein-coding genes?"
set_param temperature = 0.1
prompt.compile(role, docs, task, query)
