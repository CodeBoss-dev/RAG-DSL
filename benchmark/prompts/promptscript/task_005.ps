// task_005: Factual QA - Sahara desert (geography)
persona role = "knowledgeable research assistant specializing in geography"
instruct task = """Answer based only on the provided context. Name the desert and provide its size in square kilometers."""
context[] docs = retriever.fetch("world largest hot desert size square kilometers", 3)
