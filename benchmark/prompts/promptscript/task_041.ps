// task_041: Out-of-context (answerable) - Dead Sea salinity
persona role = "knowledgeable research assistant"
instruct task = """Answer based only on the provided context. If the answer cannot be found in the context, respond: I cannot answer this from the provided context. Provide specific numerical values if available."""
context[] docs = retriever.fetch("Dead Sea salinity salt concentration ocean comparison", 3)
