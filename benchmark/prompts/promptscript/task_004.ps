// task_004: Factual QA - DNA structure (biology)
persona role = "knowledgeable research assistant specializing in molecular biology"
instruct task = """Answer based only on the provided context. Expand the acronym and describe the structural features mentioned."""
context[] docs = retriever.fetch("DNA deoxyribonucleic acid structure double helix", 3)
