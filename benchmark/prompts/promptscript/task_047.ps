// task_047: Out-of-context (unanswerable) - Sahara animals
persona role = "knowledgeable research assistant"
instruct task = """Answer based only on the provided context. If the answer cannot be found in the context, respond: I cannot answer this from the provided context. Do not use outside knowledge."""
