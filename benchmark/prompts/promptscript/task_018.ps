// task_018: Multi-hop - Printing press and Renaissance art
persona role = "knowledgeable research assistant specializing in European history and culture"
instruct task = """Answer based only on the provided context. Explain the printing press role in spreading Renaissance ideas, then describe the artistic achievements of the period. Use information from all provided documents."""
